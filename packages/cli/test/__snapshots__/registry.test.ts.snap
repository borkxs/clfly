// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`register > claude-code project: adds one entry and keeps the others 1`] = `
"{
  "theme": "dark",
  "mcpServers": {
    "other": {
      "command": "other"
    },
    "demo": {
      "command": "./packages/demo/bin/demo.mjs",
      "args": [
        "mcp",
        "serve",
        "--root",
        "./packages/demo"
      ]
    }
  }
}
"
`;

exports[`register > claude-code user: adds one entry and keeps the others 1`] = `
"{
  "theme": "dark",
  "mcpServers": {
    "other": {
      "command": "other"
    },
    "demo": {
      "command": "<tmp>/project/packages/demo/bin/demo.mjs",
      "args": [
        "mcp",
        "serve",
        "--root",
        "<tmp>/project/packages/demo"
      ]
    }
  }
}
"
`;

